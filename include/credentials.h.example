#pragma once

// Lilygo T-2Can native CAN B / TWAI pins
#define CAN_TX_PIN 7
#define CAN_RX_PIN 6

// OLED on the QWIIC connector
#define OLED_SDA_PIN 17
#define OLED_SCL_PIN 18
#define OLED_SCREEN_WIDTH 128
#define OLED_SCREEN_HEIGHT 64
#define OLED_RESET_PIN -1

// BLE identifiers; the client must use the same UUIDs
#define BLE_SERVICE_UUID     "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define BLE_SPEED_CHAR_UUID  "beb5483e-36e1-4688-b7f5-ea07361b26a8"
#define BLE_SOC_CHAR_UUID    "b9a2c6e5-5f91-4e8d-a5a2-24b9e8d8c002"
#define BLE_POWER_CHAR_UUID  "b9a2c6e5-5f91-4e8d-a5a2-24b9e8d8c003"

// Example candidate frame layouts; verify these against the target vehicle.
#define EV_SPEED_CAN_ID 0x201
#define EV_SPEED_CAN_ID_ALT 0x128
#define EV_SPEED_DATA_BYTE 1
#define EV_SPEED_SCALE_KMH 1.0f

#define EV_SOC_CAN_ID 0x318
#define EV_SOC_DATA_BYTE 0

// Disabled until a verified power frame ID and scale are configured.
// The decoder expects a signed, little-endian 16-bit value.
#define EV_POWER_CAN_ID 0xFFFFFFFFUL
#define EV_POWER_LSB_BYTE 0
#define EV_POWER_MSB_BYTE 1
#define EV_POWER_SCALE_KW 0.1f

#define INACTIVITY_TIMEOUT_MS 300000

// Set to 1 to print raw CAN frames only when an ID's data or length changes.
#define CAN_DIAGNOSTIC_MODE 0
